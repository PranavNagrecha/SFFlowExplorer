{
  "name": "sfflow-explorer",
  "version": "0.1.0",
  "description": "Converts Salesforce Flow metadata XML (.flow-meta.xml) into Draw.io-compatible diagrams (SFFlowExplorer)",
  "license": "MIT",
  "type": "module",
  "main": "dist/cli/index.js",
  "bin": {
    "sfflow-explorer": "./dist/cli/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "salesforce",
    "flow",
    "metadata",
    "drawio",
    "diagram",
    "visualization",
    "cli",
    "devtools"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit",
    "generate": "node dist/cli/index.js generate"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "dagre": "^0.8.5",
    "fast-xml-parser": "^4.3.0"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.52",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
