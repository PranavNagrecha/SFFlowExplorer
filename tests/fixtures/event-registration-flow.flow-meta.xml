<!-- === Record Lookups === -->
<recordLookups>
  <name>Get_Event</name>
  <label>Get Event Record</label>
  <locationX>440</locationX>
  <locationY>242</locationY>
  <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
  <connector><targetReference>Check_Presenter_Role</targetReference></connector>
  <getFirstRecordOnly>true</getFirstRecordOnly>
  <object>Event__c</object>
  <storeOutputAutomatically>true</storeOutputAutomatically>
</recordLookups>

<recordLookups>
  <name>Get_Pending_Registrations</name>
  <label>Get Pending Registrations</label>
  <locationX>336</locationX>
  <locationY>458</locationY>
  <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
  <connector><targetReference>Select_Attendee_Screen</targetReference></connector>
  <getFirstRecordOnly>false</getFirstRecordOnly>
  <object>Registration__c</object>
  <storeOutputAutomatically>true</storeOutputAutomatically>
</recordLookups>

<recordLookups>
  <name>Get_Remaining</name>
  <label>Get Remaining Registrations</label>
  <locationX>336</locationX>
  <locationY>2846</locationY>
  <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
  <connector><targetReference>Check_Remaining</targetReference></connector>
  <getFirstRecordOnly>true</getFirstRecordOnly>
  <object>Registration__c</object>
  <storeOutputAutomatically>true</storeOutputAutomatically>
</recordLookups>

<!-- === Decisions === -->
<decisions>
  <name>Check_Presenter_Role</name>
  <label>Is User the Presenter?</label>
  <locationX>440</locationX>
  <locationY>350</locationY>
  <defaultConnector><targetReference>Error_Screen</targetReference></defaultConnector>
  <defaultConnectorLabel>No</defaultConnectorLabel>
  <rules>
    <name>Yes_Presenter</name>
    <conditionLogic>and</conditionLogic>
    <connector><targetReference>Get_Pending_Registrations</targetReference></connector>
    <label>Yes</label>
  </rules>
</decisions>

<decisions>
  <name>Check_Flag_Needed</name>
  <label>Flag Needed?</label>
  <locationX>336</locationX>
  <locationY>998</locationY>
  <defaultConnector><targetReference>Get_Remaining</targetReference></defaultConnector>
  <defaultConnectorLabel>No</defaultConnectorLabel>
  <rules>
    <name>Yes_Flag</name>
    <conditionLogic>and</conditionLogic>
    <connector><targetReference>Create_Flag</targetReference></connector>
    <label>Yes</label>
  </rules>
</decisions>

<decisions>
  <name>Check_Remaining</name>
  <label>More Registrations?</label>
  <locationX>336</locationX>
  <locationY>2954</locationY>
  <defaultConnector><targetReference>Update_Event</targetReference></defaultConnector>
  <defaultConnectorLabel>No</defaultConnectorLabel>
  <rules>
    <name>Yes_More</name>
    <conditionLogic>and</conditionLogic>
    <connector>
      <isGoTo>true</isGoTo>
      <targetReference>Get_Pending_Registrations</targetReference>
    </connector>
    <label>Yes</label>
  </rules>
</decisions>

<!-- === Action Calls === -->
