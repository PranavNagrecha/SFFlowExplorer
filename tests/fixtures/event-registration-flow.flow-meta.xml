  <locationX>336</locationX>
  <locationY>674</locationY>
  <actionName>emailSimple</actionName>
  <actionType>emailSimple</actionType>
  <connector><targetReference>Update_Registration</targetReference></connector>
  <flowTransactionModel>CurrentTransaction</flowTransactionModel>
  <nameSegment>emailSimple</nameSegment>
</actionCalls>

<actionCalls>
  <name>Notify_Admin</name>
  <label>Notify Admin of Flag</label>
  <locationX>182</locationX>
  <locationY>2330</locationY>
  <actionName>emailSimple</actionName>
  <actionType>emailSimple</actionType>
  <connector><targetReference>Get_Remaining</targetReference></connector>
  <flowTransactionModel>CurrentTransaction</flowTransactionModel>
  <nameSegment>emailSimple</nameSegment>
</actionCalls>

<!-- === Record Updates === -->
<recordUpdates>
