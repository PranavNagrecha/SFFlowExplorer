  <locationX>336</locationX>
  <locationY>782</locationY>
  <connector><targetReference>Check_Flag_Needed</targetReference></connector>
  <object>Registration__c</object>
</recordUpdates>

<recordUpdates>
  <name>Update_Event</name>
  <label>Mark Event Closed</label>
  <locationX>468</locationX>
  <locationY>3062</locationY>
