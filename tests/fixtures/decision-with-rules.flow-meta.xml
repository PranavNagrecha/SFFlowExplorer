                <rightValue><stringValue>Silver</stringValue></rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Silver</targetReference>
            </connector>
            <label>Is Silver</label>
        </rules>
        <rules>
            <name>Is_Bronze</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>accountType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><stringValue>Bronze</stringValue></rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Bronze</targetReference>
            </connector>
            <label>Is Bronze</label>
        </rules>
    </decisions>
    <assignments>
        <name>Assign_Gold</name>
        <label>Set Gold Discount</label>
        <locationX>50</locationX>
        <locationY>290</locationY>
